        replacement_content: "                              {/* Daily Conduct stars */}\n                              <div className=\"text-[10px] font-bold flex items-center justify-center min-h-[16px] xl:text-[11px]\">\n                                {behaviorStars === 1 && (\n                                  <span className={isSelected ? \'text-amber-300\' : \'text-amber-500\'} title=\"Todo hecho (1\342\230\205)\">\360\237\214\237</span>\n                                )}\n                                {behaviorStars === 0.5 && (\n                                  <span className={isSelected ? \'text-yellow-250\' : \'text-amber-500 font-bold\'} title=\"Media estrella (\302\275\342\230\205)\">\360\237\214\227</span>\n                                )}\n                                {behaviorStars === -1 && (\n                                  <span className=\"text-red-500 font-extrabold\" title=\"Dem\303\251rito (\342\232\240\357\270\217)\">\342\232\240\357\270\217</span>\n                                )}\n                                {(behaviorStars === 0 || behaviorStars === undefined) && (\n                                  <span className=\"text-slate-350 font-normal\">\342\200\224</span>\n                                )}\n                              </div>"
      }
