ter gap-3 animate-pulse shadow-xs\">\n                          <span className=\"text-3xl animate-bounce animate-duration-1000\">\360\237\216\211</span>\n                          <div className=\"flex-1 min-w-0\">\n                            <p className=\"font-extrabold text-pink-700 text-xs sm:text-sm\">\n                              \302\241S\303\232PER FELICIDADES! \360\237\216\211 \302\241META ALCANZADA!\n                            </p>\n                            <p className=\"text-[11px] text-pink-600 font-semibold mt-0.5 leading-snug\">\n                              \302\241Has ganado tu dulce semanal! \302\241Buen trabajo! \360\237\215\254\360\237\215\255\360\237\215\251\360\237\222\226\n                            </p>\n                          </div>\n                        </div>\n                      ) : (\n                        <div className=\"mt-3 bg-slate-50 border border-slate-100 rounded-xl p-2.5 flex items-center justify-between text-[11px] text-slate-500 font-semibold\">\n                          <span>\360\237\216\257 Faltan <strong className=\"text-indigo-600 font-black\">{currentGoal - grandTotalPoints} puntos</strong> para abrir tu premio.</span>\n                          <span>\302\241Sigue adelante! \360\237\222\252</span>\n                        </div>\n                      )}\n                    </div>"
