      text: "Here is the full initial file tree for the application:\n/.env.local\n/.gitignore\n/App.tsx\n/components/AvatarPicker.tsx\n/components/ChildCard.tsx\n/components/FeedbackModal.tsx\n/components/StarRating.tsx\n/components/Toast.tsx\n/components/icons.tsx\n/constants.ts\n/contexts/ToastContext.tsx\n/index.html\n/index.tsx\n/metadata.json\n/package.json\n/services/geminiService.ts\n/src/App.tsx\n/tsconfig.json\n/types.ts\n/vite.config.ts\n\nThe following dependencies are installed:\n@google/genai: ^1.20.0\nreact: ^19.1.1\nreact-dom: ^19.1.1\n\nThe following devDependencies are installed:\n@types/node: ^22.14.0\n@vitejs/plugin-react: ^5.0.0\ntypescript: ~5.8.2\nvite: ^6.2.0\n\nKey file contents:\n\n--- /App.tsx ---\n```typescript\nimport React, { useState, useCallback, useEffect } from \'react\';\nimport type { Child, FeedbackEntry } from \'./types\';\nimport ChildCard from \'./components/ChildCard\';\nimport { ResetIcon, UserPlusIcon } from \'./components/icons\';\nimport AvatarPicker from \'./components/AvatarPicker\';\nimport { useToast } from \'./contexts/ToastContext\';\n\nconst APP_STORAGE_KEY = \'weeklyBehaviorChartApp\';\n\nconst App: React.FC = () => {\n  const [children, setChildren] = useState<Child[]>(() => {\n    try {\n      const storedData = window.localStorage.getItem(APP_STORAGE_KEY);\n      return storedData ? JSON.parse(storedData) : [];\n    } catch (error) {\n      console.error(\"Error loading data from localStorage\", error);\n      return [];\n    }\n  });\n  const [newChildName, setNewChildName] = useState(\'\');\n  const [newChildAvatar, setNewChildAvatar] = useState(\'\360\237\230\212\');\n  const [isAvatarPickerOpen, setIsAvatarPickerOpen] = useState(false);\n  const { addToast } = useToast();\n\n  useEffect(() => {\n    try {\n      window.localStorage.setItem(APP_STORAGE_KEY, JSON.stringify(children));\n    } catch (error) {\n      console.error(\"Error saving data to localStorage\", error);\n    }\n  }, [children]);\n\n\n  const handleAddChild = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (newChildName.trim() === \'\') return;\n\n    const newChild: Child = {\n      id: Date.now().toString(),\n      name: newChildName.trim(),\n      avatar: newChildAvatar,\n      scores: Array(7).fill(0),\n      feedbackHistory: [],\n    };\n\n    setChildren([...children, newChild]);\n    addToast(`${newChild.name} ha sido a\303\261adido/a.`, \'success\');\n    setNewChildName(\'\');\n    setNewChildAvatar(\'\360\237\230\212\'); // Reset to default for the next one\n  };\n\n  const updateScore = useCallback((childId: string, dayIndex: number, score: number) => {\n    setChildren(prevChildren =>\n      prevChildren.map(child =>\n        child.id === childId\n          ? {\n              ...child,\n              scores: child.scores.map((s, i) => (i === dayIndex ? score : s)),\n            }\n          : child\n      )\n    );\n  }, []);\n\n  const handleUpdateAvatar = (childId: string, avatar: string) => {\n    setChildren(prevChildren =>\n      prevChildren.map(child =>\n        child.id === childId ? { ...child, avatar } : child\n      )\n    );\n  };\n  \n  const handleAddFeedback = useCallback((childId: string, feedbackText: string) => {\n    const newFeedback: FeedbackEntry = {\n        text: feedbackText,\n        timestamp: new Date().toISOString(),\n    };\n    setChildren(prevChildren =>\n        prevChildren.map(child =>\n            child.id === childId\n                ? { ...child, feedbackHistory: [newFeedback, ...child.feedbackHistory] }\n                : child\n        )\n    );\n  }, []);\n\n  const handleResetAll = () => {\n    if (window.confirm(\'\302\277Est\303\241s seguro de que quieres borrar todas las puntuaciones de la semana?\')) {\n        setChildren(prevChildren => \n            prevChildren.map(child => ({...child, scores: Array(7).fill(0)}))\n        );\n        addToast(\'Puntuaciones de la semana reiniciadas.\', \'info\');\n    }\n  };\n\n  const handleRemoveChild = (childId: string) => {\n    const childToRemove = children.find(c => c.id === childId);\n    if (window.confirm(\'\302\277Est\303\241s seguro de que quieres eliminar a este ni\303\261o? Esta acci\303\263n no se puede deshacer.\')) {\n        setChildren(prevChildren => prevChildren.filter(child => child.id !== childId));\n        if (childToRemove) {\n            addToast(`${childToRemove.name} ha sido eliminado/a.`, \'error\');\n        }\n    }\n  }\n\n  return (\n    <div className=\"min-h-screen bg-sky-50 font-sans text-slate-800\">\n       <AvatarPicker \n        isOpen={isAvatarPickerOpen}\n        onClose={() => setIsAvatarPickerOpen(false)}\n        onSelect={setNewChildAvatar}\n        currentAvatar={newChildAvatar}\n      />\n      <div className=\"container mx-auto p-4 sm:p-6 lg:p-8\">\n        <header className=\"text-center mb-8\">\n          <h1 className=\"text-4xl sm:text-5xl font-bold text-sky-700 tracking-tight\">\n            Tabla de Comportamiento Semanal\n          </h1>\n          <p className=\"text-slate-500 mt-2 text-lg\">\n            \302\241Registra los logros de tus peques y celebra su progreso!\n          </p>\n        </header>\n\n        <main>\n          <div className=\"max-w-md mx-auto bg-white rounded-xl shadow-lg p-6 mb-8 border border-sky-100\">\n            <h2 className=\"text-2xl font-semibold text-sky-600 mb-4\">A\303\261adir un ni\303\261o/a</h2>\n            <form onSubmit={handleAddChild} className=\"flex flex-col sm:flex-row items-center gap-3\">\n              <button\n                type=\"button\"\n                onClick={() => setIsAvatarPickerOpen(true)}\n                className=\"text-5xl bg-slate-100 rounded-lg p-2 transition-transform hover:scale-110 focus:outline-none focus:ring-2 focus:ring-sky-500\"\n                aria-label=\"Elegir avatar\"\n              >\n                {newChildAvatar}\n              </button>\n              <input\n                type=\"text\"\n                value={newChildName}\n                onChange={(e) => setNewChildName(e.target.value)}\n                placeholder=\"Nombre del ni\303\261o/a\"\n                className=\"w-full flex-grow p-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-sky-500 focus:border-sky-500 transition\"\n              />\n              <button\n                type=\"submit\"\n                className=\"w-full sm:w-auto bg-sky-600 text-white font-bold p-3 rounded-lg hover:bg-sky-700 transition-colors disabled:bg-slate-300 flex items-center justify-center gap-2\"\n                disabled={!newChildName.trim()}\n              >\n                <UserPlusIcon />\n                <span>A\303\261adir</span>\n              </button>\n            </form>\n          </div>\n\n          {children.length > 0 && (\n              <div className=\"text-center mb-8\">\n                 <button onClick={handleResetAll} className=\"bg-amber-500 text-white font-semibold py-2 px-4 rounded-lg hover:bg-amber-600 transition-colors flex items-center gap-2 mx-auto\">\n                    <ResetIcon />\n                    Reiniciar Puntuaciones de la Semana\n                </button>\n              </div>\n          )}\n\n          <div className=\"space-y-6\">\n            {children.map(child => (\n              <ChildCard \n                key={child.id} \n                child={child} \n                onUpdateScore={updateScore} \n                onRemoveChild={handleRemoveChild} \n                onUpdateAvatar={handleUpdateAvatar}\n                onAddFeedback={handleAddFeedback}\n              />\n            ))}\n          </div>\n\n          {children.length === 0 && (\n            <div className=\"text-center py-16 px-6 bg-white rounded-xl shadow-lg border border-sky-100\">\n                <p className=\"text-slate-500 text-xl\">A\303\272n no has a\303\261adido a ning\303\272n ni\303\261o.</p>\n                <p className=\"text-slate-400 mt-2\">Usa el formulario de arriba para empezar.</p>\n            </div>\n          )}\n        </main>\n\n        <footer className=\"text-center mt-12 text-slate-400 text-sm\">\n          <p>Creado con \342\235\244\357\270\217 para fomentar el refuerzo positivo.</p>\n        </footer>\n      </div>\n    </div>\n  );\n};\n\nexport default App;\n```\n\n--- /index.html ---\n```html\n<!DOCTYPE html>\n<html lang=\"es\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Tabla de Comportamiento Semanal</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <style>\n      body {\n        background-color: #f0f9ff; /* A light, friendly sky blue */\n      }\n      .child-card-enter {\n        animation: slide-up 0.5s ease-out both;\n      }\n      .toast-anim {\n        animation: slide-in-right 0.5s cubic-bezier(0.250, 0.460, 0.450, 0.940) both;\n      }\n      .toast-exit {\n        animation: fade-out-right 0.5s cubic-bezier(0.250, 0.460, 0.450, 0.940) both;\n      }\n      .animate-fade-in {\n        animation: fade-in 0.3s ease-in-out both;\n      }\n\n      @keyframes slide-up {\n        0% { transform: translateY(20px); opacity: 0; }\n        100% { transform: translateY(0); opacity: 1; }\n      }\n      @keyframes slide-in-right {\n        0% { transform: translateX(100px); opacity: 0; }\n        100% { transform: translateX(0); opacity: 1; }\n      }\n      @keyframes fade-out-right {\n        0% { transform: translateX(0); opacity: 1; }\n        100% { transform: translateX(50px); opacity: 0; }\n      }\n      @keyframes fade-in {\n        0% { opacity: 0; transform: scale(0.95); }\n        100% { opacity: 1; transform: scale(1); }\n      }\n    </style>\n  <script type=\"importmap\">\n{\n  \"imports\": {\n    \"react/\": \"https://aistudiocdn.com/react@^19.1.1/\",\n    \"react\": \"https://aistudiocdn.com/react@^19.1.1\",\n    \"react-dom/\": \"https://aistudiocdn.com/react-dom@^19.1.1/\",\n    \"@google/genai\": \"https://aistudiocdn.com/@google/genai@^1.20.0\"\n  }\n}\n</script>\n<link rel=\"stylesheet\" href=\"/index.css\">\n</head>\n  <body>\n    <noscript>You need to enable JavaScript to run this app.</noscript>\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/index.tsx\"></script>\n  </body>\n</html>\n```\n\n--- /metadata.json ---\n```json\n{\n  \"name\": \"Tabla de Comportamiento Semanal\",\n  \"description\": \"Una aplicaci\303\263n para seguir y puntuar el comportamiento semanal de los ni\303\261os, con feedback generado por IA para fomentar el refuerzo positivo.\",\n  \"requestFramePermissions\": [],\n  \"majorCapabilities\": []\n}\n```\n\n--- /src/App.tsx ---\n```typescript\n\nimport React, { useState, useCallback, useEffect } from \'react\';\nimport type { Child, FeedbackEntry } from \'./types\';\nimport ChildCard from \'./components/ChildCard\';\nimport { ResetIcon, UserPlusIcon } from \'./components/icons\';\nimport AvatarPicker from \'./components/AvatarPicker\';\nimport { useToast } from \'./contexts/ToastContext\';\n\nconst APP_STORAGE_KEY = \'weeklyBehaviorChartApp\';\n\nconst App: React.FC = () => {\n  const [children, setChildren] = useState<Child[]>(() => {\n    try {\n      const storedData = window.localStorage.getItem(APP_STORAGE_KEY);\n      return storedData ? JSON.parse(storedData) : [];\n    } catch (error) {\n      console.error(\"Error loading data from localStorage\", error);\n      return [];\n    }\n  });\n  const [newChildName, setNewChildName] = useState(\'\');\n  const [newChildAvatar, setNewChildAvatar] = useState(\'\360\237\230\212\');\n  const [isAvatarPickerOpen, setIsAvatarPickerOpen] = useState(false);\n  const { addToast } = useToast();\n\n  useEffect(() => {\n    try {\n      window.localStorage.setItem(APP_STORAGE_KEY, JSON.stringify(children));\n    // FIX: Corrected the syntax of the catch block. It was missing parentheses and curly braces, causing subsequent functions to be declared outside the component\'s scope.\n    } catch (error) {\n      console.error(\"Error saving data to localStorage\", error);\n    }\n  }, [children]);\n\n\n  const handleAddChild = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (newChildName.trim() === \'\') return;\n\n    const newChild: Child = {\n      id: Date.now().toString(),\n      name: newChildName.trim(),\n      avatar: newChildAvatar,\n      scores: Array(7).fill(0),\n      feedbackHistory: [],\n    };\n\n    setChildren([...children, newChild]);\n    addToast(`${newChild.name} ha sido a\303\261adido/a.`, \'success\');\n    setNewChildName(\'\');\n    setNewChildAvatar(\'\360\237\230\212\'); // Reset to default for the next one\n  };\n\n  const updateScore = useCallback((childId: string, dayIndex: number, score: number) => {\n    setChildren(prevChildren =>\n      prevChildren.map(child =>\n        child.id === childId\n          ? {\n              ...child,\n              scores: child.scores.map((s, i) => (i === dayIndex ? score : s)),\n            }\n          : child\n      )\n    );\n  }, []);\n\n  const handleUpdateAvatar = (childId: string, avatar: string) => {\n    setChildren(prevChildren =>\n      prevChildren.map(child =>\n        child.id === childId ? { ...child, avatar } : child\n      )\n    );\n  };\n  \n  const handleAddFeedback = useCallback((childId: string, feedbackText: string) => {\n    const newFeedback: FeedbackEntry = {\n        text: feedbackText,\n        timestamp: new Date().toISOString(),\n    };\n    setChildren(prevChildren =>\n        prevChildren.map(child =>\n            child.id === childId\n                ? { ...child, feedbackHistory: [newFeedback, ...child.feedbackHistory] }\n                : child\n        )\n    );\n  }, []);\n\n  const handleResetAll = () => {\n    if (window.confirm(\'\302\277Est\303\241s seguro de que quieres borrar todas las puntuaciones de la semana?\')) {\n        setChildren(prevChildren => \n            prevChildren.map(child => ({...child, scores: Array(7).fill(0)}))\n        );\n        addToast(\'Puntuaciones de la semana reiniciadas.\', \'info\');\n    }\n  };\n\n  const handleRemoveChild = (childId: string) => {\n    const childToRemove = children.find(c => c.id === childId);\n    if (window.confirm(\'\302\277Est\303\241s seguro de que quieres eliminar a este ni\303\261o? Esta acci\303\263n no se puede deshacer.\')) {\n        setChildren(prevChildren => prevChildren.filter(child => child.id !== childId));\n        if (childToRemove) {\n            addToast(`${childToRemove.name} ha sido eliminado/a.`, \'error\');\n        }\n    }\n  }\n\n  return (\n    <div className=\"min-h-screen bg-sky-50 font-sans text-slate-800\">\n       <AvatarPicker \n        isOpen={isAvatarPickerOpen}\n        onClose={() => setIsAvatarPickerOpen(false)}\n        onSelect={setNewChildAvatar}\n        currentAvatar={newChildAvatar}\n      />\n      <div className=\"container mx-auto p-4 sm:p-6 lg:p-8\">\n        <header className=\"text-center mb-8\">\n          <h1 className=\"text-4xl sm:text-5xl font-bold text-sky-700 tracking-tight\">\n            Tabla de Comportamiento Semanal\n          </h1>\n          <p className=\"text-slate-500 mt-2 text-lg\">\n            \302\241Registra los logros de tus peques y celebra su progreso!\n          </p>\n        </header>\n\n        <main>\n          <div className=\"max-w-md mx-auto bg-white rounded-xl shadow-lg p-6 mb-8 border border-sky-100\">\n            <h2 className=\"text-2xl font-semibold text-sky-600 mb-4\">A\303\261adir un ni\303\261o/a</h2>\n            <form onSubmit={handleAddChild} className=\"flex flex-col sm:flex-row items-center gap-3\">\n              <button\n                type=\"button\"\n                onClick={() => setIsAvatarPickerOpen(true)}\n                className=\"text-5xl bg-slate-100 rounded-lg p-2 transition-transform hover:scale-110 focus:outline-none focus:ring-2 focus:ring-sky-500\"\n                aria-label=\"Elegir avatar\"\n              >\n                {newChildAvatar}\n              </button>\n              <input\n                type=\"text\"\n                value={newChildName}\n                onChange={(e) => setNewChildName(e.target.value)}\n                placeholder=\"Nombre del ni\303\261o/a\"\n                className=\"w-full flex-grow p-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-sky-500 focus:border-sky-500 transition\"\n              />\n              <button\n                type=\"submit\"\n                className=\"w-full sm:w-auto bg-sky-600 text-white font-bold p-3 rounded-lg hover:bg-sky-700 transition-colors disabled:bg-slate-300 flex items-center justify-center gap-2\"\n                disabled={!newChildName.trim()}\n              >\n                <UserPlusIcon />\n                <span>A\303\261adir</span>\n              </button>\n            </form>\n          </div>\n\n          {children.length > 0 && (\n              <div className=\"text-center mb-8\">\n                 <button onClick={handleResetAll} className=\"bg-amber-500 text-white font-semibold py-2 px-4 rounded-lg hover:bg-amber-600 transition-colors flex items-center gap-2 mx-auto\">\n                    <ResetIcon />\n                    Reiniciar Puntuaciones de la Semana\n                </button>\n              </div>\n          )}\n\n          <div className=\"space-y-6\">\n            {children.map(child => (\n              <ChildCard \n                key={child.id} \n                child={child} \n                onUpdateScore={updateScore} \n                onRemoveChild={handleRemoveChild} \n                onUpdateAvatar={handleUpdateAvatar}\n                onAddFeedback={handleAddFeedback}\n              />\n            ))}\n          </div>\n\n          {children.length === 0 && (\n            <div className=\"text-center py-16 px-6 bg-white rounded-xl shadow-lg border border-sky-100\">\n                <p className=\"text-slate-500 text-xl\">A\303\272n no has a\303\261adido a ning\303\272n ni\303\261o.</p>\n                <p className=\"text-slate-400 mt-2\">Usa el formulario de arriba para empezar.</p>\n            </div>\n          )}\n        </main>\n\n        <footer className=\"text-center mt-12 text-slate-400 text-sm\">\n          <p>Creado con \342\235\244\357\270\217 para fomentar el refuerzo positivo.</p>\n        </footer>\n      </div>\n    </div>\n  );\n};\n\nexport default App;\n\n```\n\n--- /tsconfig.json ---\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"experimentalDecorators\": true,\n    \"useDefineForClassFields\": false,\n    \"module\": \"ESNext\",\n    \"lib\": [\n      \"ES2022\",\n      \"DOM\",\n      \"DOM.Iterable\"\n    ],\n    \"skipLibCheck\": true,\n    \"types\": [\n      \"node\"\n    ],\n    \"moduleResolution\": \"bundler\",\n    \"isolatedModules\": true,\n    \"moduleDetection\": \"force\",\n    \"allowJs\": true,\n    \"jsx\": \"react-jsx\",\n    \"paths\": {\n      \"@/*\": [\n        \"./*\"\n      ]\n    },\n    \"allowImportingTsExtensions\": true,\n    \"noEmit\": true\n  }\n}\n```\n\n--- /vite.config.ts ---\n```typescript\nimport path from \'path\';\nimport { defineConfig, loadEnv } from \'vite\';\nimport react from \'@vitejs/plugin-react\';\n\nexport default defineConfig(({ mode }) => {\n    const env = loadEnv(mode, \'.\', \'\');\n    return {\n      server: {\n        port: 3000,\n        host: \'0.0.0.0\',\n      },\n      plugins: [react()],\n      define: {\n        \'process.env.API_KEY\': JSON.stringify(env.GEMINI_API_KEY),\n        \'process.env.GEMINI_API_KEY\': JSON.stringify(env.GEMINI_API_KEY)\n      },\n      resolve: {\n        alias: {\n          \'@\': path.resolve(__dirname, \'.\'),\n        }\n      }\n    };\n});\n\n```"
    }
  }
}
