    instruction: "Update getBehaviorFeedback to include tasks list, format them inside the prompt, and upgrade to gemini-3.5-flash."
    replacement_infos {
      original_chunk {
        target_content: "import { GoogleGenAI } from \"@google/genai\";\nimport { DAYS_OF_WEEK } from \"../constants\";\n\nconst API_KEY = process.env.API_KEY;\n\nif (!API_KEY) {\n  throw new Error(\"API_KEY environment variable not set\");\n}\n\nconst ai = new GoogleGenAI({ apiKey: API_KEY });\n\nexport async function getBehaviorFeedback(name: string, scores: number[]): Promise<string> {\n  const formattedScores = DAYS_OF_WEEK.map((day, index) => `- ${day}: ${scores[index] === 0 ? \'No puntuado\' : scores[index]}`).join(\'\\n\');\n\n  const prompt = `\n    Eres un psic\303\263logo infantil amigable y experto en refuerzo positivo. Tu tarea es analizar el comportamiento semanal de un ni\303\261o y proporcionar un resumen alentador y constructivo para sus padres.\n\n    Nombre del ni\303\261o: ${name}\n\n    Puntuaciones de la semana (de 1 a 5, donde 1 es un comportamiento muy dif\303\255cil y 5 es excelente. \'No puntuado\' significa que no se registr\303\263):\n    ${formattedScores}\n\n    Por favor, escribe un p\303\241rrafo corto (no m\303\241s de 4-5 frases) en espa\303\261ol que:\n    1. Comience de forma positiva, reconociendo el esfuerzo general de ${name}.\n    2. Destaque los d\303\255as con las puntuaciones m\303\241s altas (4 o 5) como logros espec\303\255ficos.\n    3. Si hay d\303\255as con puntuaciones bajas (1 o 2), sugiere de forma muy suave y constructiva c\303\263mo se puede mejorar, sin ser cr\303\255tico. Por ejemplo, \"El [d\303\255a] pareci\303\263 un poco m\303\241s desafiante. Podr\303\255amos charlar sobre qu\303\251 pas\303\263 y pensar juntos en c\303\263mo hacer que la pr\303\263xima semana sea a\303\272n mejor\". No menciones los d\303\255as no puntuados.\n    4. Termina con una nota muy positiva y de \303\241nimo para la pr\303\263xima semana.\n    5. Usa un tono c\303\241lido, amigable y de apoyo. Habla directamente a los padres (\"Pod\303\251is estar orgullosos\", \"Recordadle a ${name}...\", \"\302\241Gran trabajo esta semana!\").\n    `;\n\n  try {\n    const response = await ai.models.generateContent({\n        model: \'gemini-2.5-flash\',\n        contents: prompt,\n    });\n    return response.text;\n  } catch (error) {\n    console.error(\"Error fetching feedback from Gemini API:\", error);\n    throw new Error(\"Failed to generate feedback. Please check the API configuration.\");\n  }\n}"
        replacement_content: "import { GoogleGenAI } from \"@google/genai\";\nimport { DAYS_OF_WEEK } from \"../constants\";\nimport type { Task } from \"../types\";\n\nconst API_KEY = process.env.API_KEY;\n\nif (!API_KEY) {\n  throw new Error(\"API_KEY environment variable not set\");\n}\n\nconst ai = new GoogleGenAI({ apiKey: API_KEY });\n\nexport async function getBehaviorFeedback(name: string, scores: number[], tasks?: Task[]): Promise<string> {\n  const formattedScores = DAYS_OF_WEEK.map((day, index) => `- ${day}: ${scores[index] === 0 ? \'No puntuado\' : scores[index] + \' estrellas\'}`).join(\'\\n\');\n\n  let tasksDescription = \'No hay tareas asignadas todav\303\255a para esta semana.\';\n  if (tasks && tasks.length > 0) {\n    tasksDescription = tasks.map(task => {\n      const assignedDaysStr = task.days.map(d => DAYS_OF_WEEK[d]).join(\', \');\n      const completedDaysList = Object.keys(task.completed)\n        .filter(k => task.completed[Number(k)])\n        .map(k => DAYS_OF_WEEK[Number(k)]);\n      \n      const completedDaysStr = completedDaysList.length > 0 ? completedDaysList.join(\', \') : \'ninguno\';\n      const completedCount = Object.keys(task.completed).filter(k => task.completed[Number(k)] && task.days.includes(Number(k))).length;\n      const assignedCount = task.days.length;\n      \n      return `- Tarea: \"${task.title}\" (Asignada: ${assignedDaysStr}). Completada ${completedCount} de ${assignedCount} veces (D\303\255as completados: ${completedDaysStr}).`;\n    }).join(\'\\n\');\n  }\n\n  const prompt = `\n    Eres un psic\303\263logo infantil amigable y experto en refuerzo positivo. Tu tarea es analizar el comportamiento semanal y el cumplimiento de tareas de un ni\303\261o/a y proporcionar un resumen alentador y constructivo para sus padres.\n\n    Nombre del ni\303\261o/a: ${name}\n\n    Puntuaciones de la conducta general de la semana (de 1 a 5, donde 1 es un comportamiento muy dif\303\255cil y 5 es excelente. \'No puntuado\' significa que no se registr\303\263):\n    ${formattedScores}\n\n    Cumplimiento de tareas asignadas esta semana:\n    ${tasksDescription}\n\n    Por favor, escribe un p\303\241rrafo corto (no m\303\241s de 4-5 frases) en espa\303\261ol que:\n    1. Comience de forma muy positiva, reconociendo el esfuerzo general de ${name} y celebrando las tareas que ha completado con \303\251xito.\n    2. Destaque los logros espec\303\255ficos (d\303\255as de 4 o 5 estrellas, o tareas realizadas con alta constancia).\n    3. Si hay puntuaciones de conducta bajas (1 o 2) o tareas abandonadas, proporciona una sugerencia muy amigable, pedag\303\263gica y constructiva para motivar al ni\303\261o sin ser cr\303\255tico.\n    4. Termine con una nota inspiradora y de apoyo para los padres de cara a la pr\303\263xima semana.\n    5. Mantenga un tono c\303\241lido, comprensivo y profesional, dirigi\303\251ndose directamente a los padres.\n    `;\n\n  try {\n    const response = await ai.models.generateContent({\n        model: \'gemini-3.5-flash\',\n        contents: prompt,\n    });\n    return response.text || \"No se pudo obtener feedback en este momento.\";\n  } catch (error) {\n    console.error(\"Error fetching feedback from Gemini API:\", error);\n    throw new Error(\"Failed to generate feedback. Please check the API configuration.\");\n  }\n}"
      }
      num_matches: 1
    }
  }
}
