        target_content: "    return (\n        <div className=\"bg-white rounded-2xl shadow-lg overflow-hidden border border-sky-100 transition-shadow hover:shadow-xl child-card-enter\">\n            {feedback && <FeedbackModal feedback={feedback} childName={child.name} onClose={() => setFeedback(null)} />}\n            <AvatarPicker \n                isOpen={isAvatarPickerOpen}\n                onClose={() => setIsAvatarPickerOpen(false)}\n                onSelect={(avatar) => onUpdateAvatar(child.id, avatar)}\n                currentAvatar={child.avatar}\n            />\n            <div className=\"p-5 sm:p-6\">\n                <div className=\"flex justify-between items-start\">\n                    <div className=\"flex items-center gap-4\">\n                        <button \n                            onClick={() => setIsAvatarPickerOpen(true)}\n                            className=\"text-5xl rounded-lg p-1 transition-transform hover:scale-110 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sky-500\"\n                            aria-label={`Cambiar avatar para ${child.name}`}\n                        >\n                            {child.avatar}\n                        </button>\n                        <div>\n                            <h2 className=\"text-2xl sm:text-3xl font-bold text-slate-800\">{child.name}</h2>\n                            <p className=\"text-slate-500\">Puntuaci\303\263n total: {totalScore} estrellas</p>\n                        </div>\n                    </div>\n                    <button onClick={() => onRemoveChild(child.id)} className=\"text-slate-400 hover:text-red-500 transition-colors p-1\" aria-label={`Eliminar a ${child.name}`}>\n                        <TrashIcon />\n                    </button>\n                </div>\n\n                <div className=\"mt-6 grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-4 text-center\">\n                    {DAYS_OF_WEEK.map((day, index) => (\n                        <div key={day} className=\"bg-sky-50 rounded-lg p-3\">\n                            <p className=\"font-semibold text-sky-800 text-sm mb-2\">{day}</p>\n                            <StarRating\n                                rating={child.scores[index]}\n                                onRate={(score) => onUpdateScore(child.id, index, score)}\n                            />\n                        </div>\n                    ))}\n                </div>\n                \n                <div className=\"mt-6 border-t border-slate-200 pt-4\">\n                    <details className=\"group\">\n                        <summary className=\"flex items-center gap-2 cursor-pointer text-slate-600 hover:text-sky-700 font-semibold list-none\">\n                           <HistoryIcon />\n                           <span>Historial de Feedback</span>\n                           <svg className=\"h-5 w-5 transition-transform duration-300 group-open:rotate-90\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\"><path fillRule=\"evenodd\" d=\"M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z\" clipRule=\"evenodd\" /></svg>\n                        </summary>\n                        <div className=\"mt-4 pl-4 space-y-4 max-h-60 overflow-y-auto\">\n                            {child.feedbackHistory && child.feedbackHistory.length > 0 ? (\n                                child.feedbackHistory.map((entry) => (\n                                    <div key={entry.timestamp} className=\"border-l-4 border-sky-200 pl-4 py-2 bg-slate-50 rounded-r-lg\">\n                                        <p className=\"text-xs font-semibold text-sky-600 mb-1\">{formatTimestamp(entry.timestamp)}</p>\n                                        <p className=\"text-sm text-slate-700 whitespace-pre-wrap\">{entry.text}</p>\n                                    </div>\n                                ))\n                            ) : (\n                                <p className=\"text-sm text-slate-500 italic pl-4\">A\303\272n no hay feedback guardado.</p>\n                            )}\n                        </div>\n                    </details>\n                </div>\n\n                <div className=\"mt-6 flex flex-col sm:flex-row justify-end items-center gap-4\">\n                    <button\n                        onClick={handleGetFeedback}\n                        disabled={isLoading}\n                        className=\"w-full sm:w-auto bg-gradient-to-r from-sky-500 to-indigo-500 text-white font-bold py-3 px-6 rounded-lg shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition-all disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2\"\n                    >\n                        {isLoading ? (\n                            <>\n                                <svg className=\"animate-spin h-5 w-5 text-white\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\"><circle className=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" strokeWidth=\"4\"></circle><path className=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\"></path></svg>\n                                Generando...\n                            </>\n                        ) : (\n                            <>\n                                <BrainCircuitIcon />\n                                Obtener Feedback con IA\n                            </>\n                        )}\n                    </button>\n                </div>\n            </div>\n        </div>"
        replacement_content: "    return (\n        <div className=\"bg-white rounded-2xl shadow-lg overflow-hidden border border-sky-100 transition-shadow hover:shadow-xl child-card-enter\">\n            {feedback && <FeedbackModal feedback={feedback} childName={child.name} onClose={() => setFeedback(null)} />}\n            <AvatarPicker \n                isOpen={isAvatarPickerOpen}\n                onClose={() => setIsAvatarPickerOpen(false)}\n                onSelect={(avatar) => onUpdateAvatar(child.id, avatar)}\n                currentAvatar={child.avatar}\n            />\n            <div className=\"p-4 sm:p-6\">\n                {/* Header info */}\n                <div className=\"flex justify-between items-start gap-3\">\n                    <div className=\"flex items-center gap-3 sm:gap-4 flex-1 min-w-0\">\n                        <button \n                            onClick={() => setIsAvatarPickerOpen(true)}\n                            className=\"text-4xl sm:text-5xl rounded-xl p-1 sm:p-1.5 bg-slate-50 transition-all hover:bg-slate-100 hover:scale-110 active:scale-95 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-sky-500 shrink-0\"\n                            aria-label={`Cambiar avatar para ${child.name}`}\n                        >\n                            {child.avatar}\n                        </button>\n                        <div className=\"min-w-0\">\n                            <h2 className=\"text-xl sm:text-3xl font-bold text-slate-800 truncate\" title={child.name}>\n                                {child.name}\n                            </h2>\n                            <p className=\"text-xs sm:text-base text-slate-500 mt-0.5\">\n                                Puntuaci\303\263n: <span className=\"font-semibold text-amber-500\">{totalScore}\342\230\205</span> esta semana\n                            </p>\n                        </div>\n                    </div>\n                    <button \n                        onClick={() => onRemoveChild(child.id)} \n                        className=\"text-slate-400 hover:text-red-500 active:scale-90 active:bg-red-50 rounded-full transition-all p-2.5 -mr-1.5 -mt-1.5 focus:outline-none focus:ring-2 focus:ring-red-400\" \n                        aria-label={`Eliminar a ${child.name}`}\n                    >\n                        <TrashIcon />\n                    </button>\n                </div>\n\n                {/* Days of week - Responsive Dual Layout */}\n                {/* Mobile View: Vertical list rows for extreme ease of tap and read */}\n                <div className=\"block sm:hidden mt-5 space-y-2\">\n                    {DAYS_OF_WEEK.map((day, index) => (\n                        <div key={day} className=\"flex justify-between items-center bg-sky-50/70 p-3 rounded-xl border border-sky-100/40\">\n                            <span className=\"font-bold text-sky-800 text-sm pl-1\">{day}</span>\n                            <StarRating\n                                rating={child.scores[index]}\n                                onRate={(score) => onUpdateScore(child.id, index, score)}\n                            />\n                        </div>\n                    ))}\n                </div>\n\n                {/* Tablet/Desktop View: Original horizontal grid */}\n                <div className=\"hidden sm:grid grid-cols-4 lg:grid-cols-7 gap-4 mt-6 text-center\">\n                    {DAYS_OF_WEEK.map((day, index) => (\n                        <div key={day} className=\"bg-sky-50 rounded-xl p-3 flex flex-col justify-between border border-sky-100/50 hover:bg-sky-100/30 transition-colors\">\n                            <p className=\"font-bold text-sky-800 text-sm mb-2\">{day}</p>\n                            <StarRating\n                                rating={child.scores[index]}\n                                onRate={(score) => onUpdateScore(child.id, index, score)}\n                            />\n                        </div>\n                    ))}\n                </div>\n                \n                {/* Feedback dropdown list */}\n                <div className=\"mt-6 border-t border-slate-100 pt-4\">\n                    <details className=\"group\">\n                        <summary className=\"flex items-center gap-2 cursor-pointer text-slate-600 hover:text-sky-700 font-semibold list-none select-none\">\n                           <HistoryIcon />\n                           <span>Historial de Feedback</span>\n                           <svg className=\"h-5 w-5 transition-transform duration-300 group-open:rotate-90 ml-auto sm:ml-0\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 20 20\" fill=\"currentColor\">\n                               <path fillRule=\"evenodd\" d=\"M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z\" clipRule=\"evenodd\" />\n                           </svg>\n                        </summary>\n                        <div className=\"mt-3 pl-1 sm:pl-4 space-y-3 max-h-60 overflow-y-auto custom-scrollbar\">\n                            {child.feedbackHistory && child.feedbackHistory.length > 0 ? (\n                                child.feedbackHistory.map((entry) => (\n                                    <div key={entry.timestamp} className=\"border-l-4 border-sky-200 pl-3.5 py-2.5 bg-slate-50 rounded-r-xl border border-slate-100 border-l-0 shadow-xs\">\n                                        <p className=\"text-xs font-semibold text-sky-600 mb-1\">{formatTimestamp(entry.timestamp)}</p>\n                                        <p className=\"text-xs sm:text-sm text-slate-700 whitespace-pre-wrap leading-relaxed\">{entry.text}</p>\n                                    </div>\n                                ))\n                            ) : (\n                                <p className=\"text-xs sm:text-sm text-slate-400 italic pl-5 py-2\">A\303\272n no hay feedback guardado.</p>\n                            )}\n                        </div>\n                    </details>\n                </div>\n\n                {/* AI feedback action button */}\n                <div className=\"mt-5 pt-3 border-t border-slate-50 flex justify-end\">\n                    <button\n                        onClick={handleGetFeedback}\n                        disabled={isLoading}\n                        className=\"w-full sm:w-auto bg-gradient-to-r from-sky-500 to-indigo-500 text-white font-bold py-3 px-6 rounded-xl shadow-md hover:shadow-lg transform active:scale-98 active:translate-y-0 transition-all duration-150 disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2\"\n                    >\n                        {isLoading ? (\n                            <>\n                                <svg className=\"animate-spin h-5 w-5 text-white\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\">\n                                    <circle className=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" strokeWidth=\"4\"></circle>\n                                    <path className=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\"></path>\n                                </svg>\n                                <span>Generando...</span>\n                            </>\n                        ) : (\n                            <>\n                                <BrainCircuitIcon />\n                                <span>Obtener Feedback con IA</span>\n                            </>\n                        )}\n                    </button>\n                </div>\n            </div>\n        </div>\n    );"
